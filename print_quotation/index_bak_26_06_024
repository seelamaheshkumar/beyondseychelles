function getNumLines($pdf, $width, $text) {
    return $pdf->getNumLines($text, $width);
}

function truncateText($text, $maxLength) {
    if (strlen($text) > $maxLength) {
        return substr($text, 0, $maxLength - 3) . '...';
    }
    return $text;
}

