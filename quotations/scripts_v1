function bindPrintButton() {
    $('.printBtn').on('click', function(event) {
        event.preventDefault(); // Prevent the default anchor behavior
        var qid = $(this).data('id');
        console.log("qid:", qid); // Log the qid to ensure it's correct
        var newTabUrl = '../print_quotation/index.php?Rep=' + qid; // Replace with your target page
        
        // Create a temporary anchor element and trigger click
        var tempAnchor = document.createElement('a');
        tempAnchor.href = newTabUrl;
        tempAnchor.target = '_blank';
        tempAnchor.click();
    });
}

